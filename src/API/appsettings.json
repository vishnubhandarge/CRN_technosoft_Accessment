{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SentinelAuthDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "VerySecretDefaultKeyForSentinelAuthThatMustBeLongEnoughForHmac256SecurityHeadersSecure",
    "Issuer": "SentinelAuth",
    "Audience": "SentinelAuthUsers",
    "DurationInMinutes": 15
  }
}
